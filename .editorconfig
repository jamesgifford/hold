# Matches pint.json (Laravel preset) and the .yml files under .github/.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,yaml}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{neon,json}]
indent_size = 4

{
    "name": "jamesgifford/hold",
    "description": "Reusable \"coming soon\" (pre-launch) and enhanced maintenance-mode holding pages for Laravel, with email-capture signup and launch/restore announcement notifications.",
    "type": "library",
    "keywords": [
        "laravel",
        "coming-soon",
        "prelaunch",
        "maintenance-mode",
        "holding-page",
        "email-capture",
        "waitlist"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "James Gifford",
            "email": "james@jamesgifford.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.13",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^3.0 || ^4.0"
    },
    "autoload": {
        "psr-4": {
            "JamesGifford\\Hold\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JamesGifford\\Hold\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint",
        "format:check": "vendor/bin/pint --test"
    },
    "extra": {
        "laravel": {
            "providers": [
                "JamesGifford\\Hold\\HoldServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
